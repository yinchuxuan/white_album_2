{
  "onFailure": "warn",
  "rules": [
    {"id": "error-leading-state-patch", "type": "content.regex", "source": "raw", "pattern": "^\\s*<state_patch_stream>[\\s\\S]*?<\\/state_patch_stream>", "matches": {"eq": 1}, "message": "【建议重新生成】回复必须以一个完整的前导演出 state_patch_stream 开始"},
    {"id": "error-choices-count", "type": "content.regex", "pattern": "<choices>[\\s\\S]*?<\\/choices>", "matches": {"eq": 1}, "message": "【建议重新生成】回复必须且只能包含一个完整的 choices"},
    {"id": "error-choices-structure", "type": "content.regex", "pattern": "<choices>[ \\t]*<item>[ \\t]*([^<>\\r\\n]*[^<>\\r\\n \\t])[ \\t]*</item>[ \\t]*<item>[ \\t]*([^<>\\r\\n]*[^<>\\r\\n \\t])[ \\t]*</item>[ \\t]*<item>[ \\t]*([^<>\\r\\n]*[^<>\\r\\n \\t])[ \\t]*</item>[ \\t]*<item>[ \\t]*([^<>\\r\\n]*[^<>\\r\\n \\t])[ \\t]*</item>[ \\t]*</choices>[ \\t]*$", "matches": {"eq": 1}, "message": "【建议重新生成】choices 必须在回复末尾完整占一行，按顺序包含四个非空 item 选项"},
    {"id": "warning-time-location-required", "type": "content.regex", "pattern": "^【时间地点】\\d{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12]\\d|3[01]): (?:[01]?\\d|2[0-3]):[0-5]\\d 星期[一二三四五六日]｜[^\\r\\n｜]+$", "flags": "mu", "matches": {"gte": 1}, "message": "【质量提醒】回复中缺少格式正确的时间地点行"},
    {"id": "warning-time-location-format", "type": "content.regex", "pattern": "^【时间地点】(?!\\d{4}\\.(?:0[1-9]|1[0-2])\\.(?:0[1-9]|[12]\\d|3[01]): (?:[01]?\\d|2[0-3]):[0-5]\\d 星期[一二三四五六日]｜[^\\r\\n｜]+$)[^\\r\\n]*$", "flags": "mu", "matches": {"eq": 0}, "message": "【质量提醒】存在格式不规范的时间地点行"},
    {"id": "warning-japanese-kana", "type": "content.regex", "pattern": "[\\u3040-\\u30ff]", "flags": "u", "matches": {"eq": 0}, "message": "【质量提醒】回复中出现了不应使用的日文假名"},
    {"id": "error-no-settlement", "type": "content.regex", "source": "raw", "pattern": "<state_patch\\s*>", "matches": {"eq": 0}, "message": "narrator 不得输出普通 state_patch", "onFailure": "retry"},
    {"id": "error-no-summary", "type": "content.regex", "source": "raw", "pattern": "<summary\\s*>", "matches": {"eq": 0}, "message": "narrator 不得输出 summary", "onFailure": "retry"}
  ]
}
