[
  {
    "id": "wa2-tail-roleplay-guide",
    "when": {
      "phase": "pre_send"
    },
    "then": [
      {
        "type": "replace",
        "predicate": {
          "role": "user",
          "index": "last"
        },
        "content": {
          "include": [
            {"content":"{{original_content}}\n\n<wa2_turn_context>"},
            {"when":{"state":{"PlotNode":"free"}},"content":"本轮剧情规划：{{state:PlotPlan}}"},
            {"content":"{{file:$temp.plotFile#$temp.PlotType}}"},
            {"content":"{{file:$temp.plotFile#$temp.toumaAttitudeSection}}"},
            {"content":"{{file:$temp.plotFile#$temp.setsunaAttitudeSection}}"},
            {"content":{"$import":"agents/shared/content/plot-restrictions.json"}},
            {"content":"{{file:roleplay_rules}}\n</wa2_turn_context>"}
          ],
          "join": "\n\n"
        }
      }
    ]
  }
]
